#!/usr/bin/env python3
"""nsync-gui — TUI password manager with live search and pending approvals."""
import curses
import json
import os
import subprocess
import sys
import time
import threading
import urllib.request

def _get_version():
    try:
        out = subprocess.check_output(
            ["git", "describe", "--tags", "--always"],
            cwd=os.path.dirname(os.path.realpath(__file__)),
            stderr=subprocess.DEVNULL,
        ).decode().strip()
        # "v1.5.0" -> "1.5.0", "v1.5.0-3-gabcdef" -> "1.5.0+3"
        out = out.lstrip("v")
        if "-" in out and out[0].isdigit():
            parts = out.split("-")
            out = f"{parts[0]}+{parts[1]}"
        return out
    except Exception:
        return "dev"

VERSION = _get_version()
REMOTE_URL = "https://raw.githubusercontent.com/virgilio-murillo/pass-cloud/main/scripts/nsync-gui"
CONFIG_FILE = os.path.expanduser("~/.config/nsync/config.json")
_totp_code = None  # cached TOTP for the session
_my_pending = {}  # path -> value, populated from cloud pending for this device


def _load_my_pending():
    """Fetch pending items from cloud that were submitted by this device."""
    try:
        from nsync import auth, config, sync
        cfg = config.load()
        creds = auth.authenticate(cfg)
        device_id = cfg.get("device_id", "")
        pending = sync.list_pending(creds, cfg)
        result = {}
        for _, p in pending:
            if p.get("device") == device_id and p.get("action") == "add":
                result[p["path"]] = p["content"]
        return result
    except Exception:
        return {}


def _is_trusted():
    try:
        with open(CONFIG_FILE) as f:
            return json.load(f).get("trusted", False)
    except Exception:
        return False


def _needs_totp():
    """Check if refresh token is likely expired (untrusted device, >1h)."""
    try:
        with open(CONFIG_FILE) as f:
            cfg = json.load(f)
        if cfg.get("trusted"):
            return False
        ts = cfg.get("auth_timestamp", 0)
        return (time.time() - ts) > 3600
    except Exception:
        return False


def _check_remote_version():
    """Fetch remote script and return (remote_version, raw_content) or (None, None)."""
    try:
        req = urllib.request.Request(REMOTE_URL, headers={"Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=5) as r:
            content = r.read().decode()
        for line in content.split("\n")[:20]:
            if line.startswith("VERSION"):
                remote_ver = line.split("=")[1].strip().strip('"').strip("'")
                if remote_ver != VERSION:
                    return remote_ver, content
                return None, None
        return None, None
    except Exception:
        return None, None


def nsync(args, input_text=None):
    global _totp_code
    if input_text is None and _totp_code:
        input_text = _totp_code
    try:
        p = subprocess.run(["nsync"] + args, capture_output=True, text=True, input=input_text, timeout=30)
        return p.stdout, p.stderr, p.returncode
    except Exception as e:
        return "", str(e), 1

def get_entries():
    out, err, rc = nsync(["ls"])
    if rc != 0:
        if "cloud_key" in err or "AESGCM" in err:
            return []  # untrusted device without key — show only pending
        return []
    return [l.strip() for l in out.strip().split("\n") if l.strip()]

def add_entry(path, value):
    """Add entry — value goes via stdin. Returns (ok, msg, is_pending)."""
    out, err, rc = nsync(["add", "--force", path], input_text=value)
    if rc == 0 and not _is_trusted():
        _my_pending[path] = value
        return True, (out + err).strip(), True
    return rc == 0, (out + err).strip(), False

def get_pending():
    """Get pending approvals by feeding 'q' to quit."""
    p = subprocess.Popen(["nsync", "approve"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        out, _ = p.communicate(input="q\n", timeout=10)
    except:
        p.kill()
        return []
    if "No pending" in out:
        return []
    pending = []
    lines = out.split("\n")
    current = {}
    for line in lines:
        if "--- Pending from" in line:
            if current:
                pending.append(current)
            current = {"source": line.split("from")[1].split("at")[0].strip()}
        elif "Action:" in line:
            current["action"] = line.split(":")[1].strip()
        elif "Path:" in line:
            current["path"] = line.split(":", 1)[1].strip()
        elif "New:" in line:
            current["value"] = line.split(":", 1)[1].strip()
    if current and "path" in current:
        pending.append(current)
    return pending


class TUI:
    def __init__(self, stdscr):
        self.scr = stdscr
        self.entries = []
        self.pending = []
        self.filtered = []
        self.sel = 0
        self.search = ""
        self.mode = "list"
        self.msg = ""
        self.view_val = ""
        self.view_pending = False
        self.update_available = None  # (remote_version, content) or None
        self.update_content = None
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)
        # Check for updates in background
        threading.Thread(target=self._bg_update_check, daemon=True).start()

    def _bg_update_check(self):
        ver, content = _check_remote_version()
        if ver:
            self.update_available = ver
            self.update_content = content

    def _download_update(self):
        if not self.update_content:
            return
        script_path = os.path.realpath(sys.argv[0]) if sys.argv[0] else os.path.expanduser("~/.local/bin/nsync-gui")
        try:
            with open(script_path, "w") as f:
                f.write(self.update_content)
            os.chmod(script_path, 0o755)
            self.msg = f"Updated to v{self.update_available}! Restart to use."
            self.update_available = None
            self.update_content = None
        except Exception as e:
            self.msg = f"Update failed: {e}"

    def prompt_totp(self):
        """Prompt for TOTP code within the TUI."""
        global _totp_code
        h, w = self.scr.getmaxyx()
        self.scr.clear()
        self.scr.addstr(h // 2 - 1, 2, "Session expired — TOTP required", curses.A_BOLD | curses.color_pair(2))
        self.scr.addstr(h // 2, 2, "TOTP code: ")
        self.scr.refresh()
        curses.echo()
        curses.curs_set(1)
        code = self.scr.getstr(h // 2, 13, 10).decode().strip()
        curses.noecho()
        curses.curs_set(0)
        if code:
            _totp_code = code

    def load(self):
        global _totp_code
        if _totp_code is None and _needs_totp():
            self.prompt_totp()
        self.msg = "Loading..."
        self.draw()
        self.entries = get_entries()
        if not self.entries and _totp_code:
            _totp_code = None
        self.pending = get_pending() if _is_trusted() else []
        # Load this device's pending updates from cloud
        if not _is_trusted():
            _my_pending.update(_load_my_pending())
            # Merge pending entries into the list so they're visible
            for path in _my_pending:
                if path not in self.entries:
                    self.entries.append(path)
        if not self.entries and not _is_trusted():
            self.msg = f"Untrusted device — add-only mode"
        elif _my_pending and not _is_trusted():
            self.msg = f"{len(self.entries)} entries ({len(_my_pending)} pending approval)"
        else:
            self.msg = f"{len(self.entries)} entries" + (f" | {len(self.pending)} pending!" if self.pending else "")
        self.do_filter()

    def do_filter(self):
        if self.search:
            terms = self.search.lower().split()
            self.filtered = [e for e in self.entries if all(t in e.lower() for t in terms)]
        else:
            self.filtered = self.entries
        self.sel = min(self.sel, max(0, len(self.filtered) - 1))

    def draw(self):
        self.scr.clear()
        h, w = self.scr.getmaxyx()

        # Header with version
        banner_offset = 0
        if self.update_available:
            banner = f" ⬆ v{self.update_available} available — press [U] to update "
            self.scr.addstr(0, 0, banner[:w-1], curses.A_BOLD | curses.color_pair(5))
            banner_offset = 1

        title = f" nsync v{VERSION} "
        self.scr.addstr(banner_offset, 0, "─" * w, curses.color_pair(4))
        self.scr.addstr(banner_offset, (w - len(title)) // 2, title, curses.A_BOLD | curses.color_pair(4))

        if self.mode == "view":
            self._draw_view(h, w, banner_offset)
        elif self.mode == "approve":
            self._draw_approve(h, w, banner_offset)
        else:
            self._draw_list(h, w, banner_offset)

        # Message bar
        if self.msg:
            self.scr.addstr(h-1, 0, f" {self.msg}"[:w-1], curses.color_pair(2))
        self.scr.refresh()

    def _draw_list(self, h, w, off=0):
        # Search bar
        search_display = self.search if self.search else ""
        self.scr.addstr(1+off, 0, " 🔍 ", curses.color_pair(2))
        self.scr.addstr(1+off, 4, search_display[:w-5] if search_display else "type to search...",
                       curses.A_NORMAL if search_display else curses.A_DIM)

        row = 2 + off
        # Pending section
        if self.pending and not self.search:
            self.scr.addstr(row, 0, f" ⚠ PENDING APPROVAL ({len(self.pending)})", curses.A_BOLD | curses.color_pair(3))
            row += 1
            for p in self.pending[:3]:
                self.scr.addstr(row, 2, f"  {p.get('action','?')} {p.get('path','?')}"[:w-3], curses.color_pair(3))
                row += 1
            self.scr.addstr(row, 2, "  Press [A] to approve", curses.A_DIM)
            row += 2

        # Entry list
        visible = h - row - 2
        start = max(0, self.sel - visible + 3)
        count_str = f" [{len(self.filtered)}/{len(self.entries)}]"
        self.scr.addstr(row, 0, f" Entries{count_str}", curses.A_DIM)
        row += 1

        for i, entry in enumerate(self.filtered[start:start+visible]):
            if row >= h - 2:
                break
            idx = start + i
            pending_mark = " ⏳" if entry in _my_pending else ""
            label = f"{entry}{pending_mark}"
            if idx == self.sel:
                self.scr.addstr(row, 0, f" ▸ {label}"[:w-1], curses.A_BOLD | curses.color_pair(1))
            else:
                self.scr.addstr(row, 0, f"   {label}"[:w-1])
            row += 1

        # Footer
        # Footer — compress for narrow terminals
        if w >= 80:
            footer = " ↑↓:nav  Enter:view  N:new  G:generate  U:update  D:del  A:approve  P:pull  Q:quit"
        elif w >= 60:
            footer = " N:new G:gen U:upd D:del A:approve P:pull Q:quit"
        else:
            footer = " N:new G:gen U:upd D:del Q:quit"
        self.scr.addstr(h-2, 0, footer[:w-1], curses.A_DIM)

    def _draw_view(self, h, w, off=0):
        path = self.filtered[self.sel] if self.filtered else ""
        self.scr.addstr(2+off, 0, f" {path}", curses.A_BOLD)
        if getattr(self, 'view_pending', False):
            self.scr.addstr(2+off, len(path)+2, " [pending]", curses.color_pair(2))
        self.scr.addstr(3+off, 0, "─" * min(w, 50), curses.A_DIM)
        lines = self.view_val.split("\n")
        for i, line in enumerate(lines[:h-7]):
            self.scr.addstr(4 + off + i, 2, line[:w-3], curses.color_pair(1))
        self.scr.addstr(h-2, 0, " [c]opy  [Esc/b]ack  [Q]uit"[:w-1], curses.A_DIM)

    def _draw_approve(self, h, w, off=0):
        self.scr.addstr(2+off, 0, " Pending Approvals", curses.A_BOLD | curses.color_pair(3))
        self.scr.addstr(3+off, 0, "─" * min(w, 50), curses.A_DIM)
        row = 4 + off
        for i, p in enumerate(self.pending):
            if row >= h - 4:
                break
            marker = "▸" if i == self.sel else " "
            self.scr.addstr(row, 0, f" {marker} [{p.get('action','?')}] {p.get('path','')}"[:w-1],
                           curses.A_BOLD if i == self.sel else curses.A_NORMAL)
            if p.get("value"):
                row += 1
                self.scr.addstr(row, 4, f"→ {p['value']}"[:w-5], curses.color_pair(2))
            row += 1
            self.scr.addstr(row, 4, f"from: {p.get('source','?')}"[:w-5], curses.A_DIM)
            row += 1
        self.scr.addstr(h-2, 0, " [Y]approve all  [Esc]back  [Q]uit"[:w-1], curses.A_DIM)

    def _input_path_fuzzy(self):
        """Interactive path input with live fuzzy matching and tab-completion."""
        curses.curs_set(1)
        curses.noecho()
        h, w = self.scr.getmaxyx()
        max_suggestions = min(6, h - 6)
        if max_suggestions < 1:
            max_suggestions = 1
        buf = ""
        while True:
            # Clear input + suggestion area
            for row in range(h-5, h-1):
                if 0 <= row < h:
                    self.scr.move(row, 0)
                    self.scr.clrtoeol()
            # Draw input line
            self.scr.addstr(h-5, 0, (" Path: " + buf)[:w-1], curses.A_BOLD)
            # Find matches
            matches = []
            if buf:
                bl = buf.lower()
                matches = [e for e in self.entries if bl in e.lower()]
            # Draw suggestions
            display = matches[:max_suggestions]
            for i, m in enumerate(display):
                row = h - 4 + i
                if row >= h - 1:
                    break
                attr = curses.color_pair(2) if m == buf else curses.A_DIM
                marker = " ⚠ exists" if m == buf else ""
                self.scr.addstr(row, 2, f"  {m}{marker}"[:w-3], attr)
            if not matches and buf:
                if h - 4 < h - 1:
                    self.scr.addstr(h-4, 2, "  (new path)", curses.A_DIM)
            self.scr.move(h-5, min(7 + len(buf), w-1))
            self.scr.refresh()

            key = self.scr.getch()
            if key == 10:  # Enter
                break
            elif key == 27:  # Esc
                buf = ""
                break
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                buf = buf[:-1]
            elif key == 9:  # Tab — complete to longest common prefix
                if matches:
                    common = matches[0]
                    for m in matches[1:]:
                        while common and not m.startswith(common):
                            common = common[:-1]
                    if common and len(common) > len(buf):
                        buf = common
            elif 32 <= key <= 126:
                buf += chr(key)
        # Clean the suggestion area
        for row in range(h-5, h-1):
            if 0 <= row < h:
                self.scr.move(row, 0)
                self.scr.clrtoeol()
        return buf.strip()

    def copy_to_clipboard(self, text):
        for cmd in [["xclip", "-selection", "clipboard"], ["pbcopy"]]:
            try:
                subprocess.run(cmd, input=text.encode(), check=True)
                return True
            except:
                continue
        return False

    def run(self):
        self.load()
        while True:
            self.draw()
            key = self.scr.getch()

            # Global: update
            if key == ord("U") and self.update_available:
                self.msg = f"Update to v{self.update_available}? [y/N]"
                self.draw()
                if self.scr.getch() == ord("y"):
                    self._download_update()
                else:
                    self.msg = "Update cancelled"
                continue

            if self.mode == "view":
                if key in (27, ord("b")):
                    self.mode = "list"
                elif key == ord("c"):
                    self.msg = "Copied!" if self.copy_to_clipboard(self.view_val) else "Copy failed"
                elif key == ord("Q"):
                    break
            elif self.mode == "approve":
                if key == 27:
                    self.mode = "list"
                    self.sel = 0
                elif key == ord("Y"):
                    self.msg = "Approving..."
                    self.draw()
                    p = subprocess.Popen(["nsync", "approve"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
                    try:
                        out, _ = p.communicate(input="y\n" * 50, timeout=30)
                        self.msg = "Approved!"
                    except:
                        p.kill()
                        self.msg = "Error approving"
                    self.mode = "list"
                    self.sel = 0
                    self.load()
                elif key == ord("Q"):
                    break
            else:
                # List mode — lowercase always searches, uppercase = commands
                if key == ord("Q"):
                    break
                elif key == 27:  # Esc - clear search
                    self.search = ""
                    self.do_filter()
                elif key in (curses.KEY_UP,):
                    self.sel = max(0, self.sel - 1)
                elif key in (curses.KEY_DOWN,):
                    self.sel = min(len(self.filtered) - 1, self.sel + 1)
                elif key == curses.KEY_BACKSPACE or key == 127:
                    self.search = self.search[:-1]
                    self.do_filter()
                elif key == 10:  # Enter
                    if self.filtered:
                        path = self.filtered[self.sel]
                        if path in _my_pending:
                            self.view_val = _my_pending[path]
                            self.view_pending = True
                        else:
                            self.msg = "Loading..."
                            self.draw()
                            out, err, rc = nsync(["get", path])
                            self.view_val = out.strip() if rc == 0 else f"Error: {err}"
                            self.view_pending = False
                        self.mode = "view"
                        if self.view_val and not self.view_val.startswith("Error:"):
                            self.copy_to_clipboard(self.view_val.split("\n")[0])
                            self.msg = "Copied to clipboard!"
                        else:
                            self.msg = ""
                elif key == ord("A"):
                    if self.pending:
                        self.mode = "approve"
                        self.sel = 0
                    else:
                        self.msg = "No pending approvals"
                elif key == ord("U"):
                    # Update password for selected entry
                    if self.filtered:
                        curses.echo()
                        curses.curs_set(1)
                        h, w = self.scr.getmaxyx()
                        path = self.filtered[self.sel]
                        self.scr.addstr(h-4, 0, f" Update [{path}]" + " " * (w-len(path)-10))
                        self.scr.addstr(h-3, 0, " New value ('e'=editor): " + " " * (w-26))
                        self.scr.refresh()
                        val = self.scr.getstr(h-3, 25, w-26).decode().strip()
                        if val == "e":
                            curses.noecho()
                            curses.curs_set(0)
                            # Fetch current value to pre-populate editor
                            if path in _my_pending:
                                cur_out, cur_rc = _my_pending[path], 0
                            else:
                                cur_out, _, cur_rc = nsync(["get", path])
                            curses.endwin()
                            editor = os.environ.get("EDITOR", "vim")
                            import tempfile
                            fd, tmppath = tempfile.mkstemp(suffix=".txt", prefix="nsync_")
                            if cur_rc == 0 and cur_out.strip():
                                os.write(fd, (cur_out.strip() + "\n").encode())
                                os.fsync(fd)
                            os.close(fd)
                            os.chmod(tmppath, 0o600)
                            try:
                                subprocess.call(f'{editor} "{tmppath}"', shell=True)
                                with open(tmppath) as f:
                                    val = f.read().rstrip("\n")
                            finally:
                                os.unlink(tmppath)
                            self.scr = curses.initscr()
                            curses.noecho()
                            curses.curs_set(0)
                            self.scr.keypad(True)
                            curses.start_color()
                            curses.use_default_colors()
                            curses.init_pair(1, curses.COLOR_GREEN, -1)
                            curses.init_pair(2, curses.COLOR_YELLOW, -1)
                            curses.init_pair(3, curses.COLOR_RED, -1)
                            curses.init_pair(4, curses.COLOR_CYAN, -1)
                            curses.init_pair(5, curses.COLOR_MAGENTA, -1)
                            if val.strip():
                                ok, msg, pending = add_entry(path, val)
                                self.msg = (f"Submitted '{path}' for approval" if pending else f"Updated '{path}'!") if ok else f"Error: {msg}"
                                self.load()
                            else:
                                self.msg = "Empty — cancelled"
                        elif val:
                            self.scr.addstr(h-2, 0, " Confirm:   " + " " * (w-13))
                            self.scr.refresh()
                            confirm = self.scr.getstr(h-2, 12, w-13).decode().strip()
                            curses.noecho()
                            curses.curs_set(0)
                            if confirm != val:
                                self.msg = "Values don't match — cancelled"
                            else:
                                self.msg = "Updating..."
                                self.draw()
                                ok, msg, pending = add_entry(path, val)
                                if ok:
                                    self.msg = f"Submitted '{path}' for approval" if pending else f"Updated '{path}'!"
                                else:
                                    self.msg = f"Error: {msg}"
                                self.load()
                        else:
                            curses.noecho()
                            curses.curs_set(0)
                            self.msg = "Cancelled"
                elif key == ord("N"):
                    h, w = self.scr.getmaxyx()
                    path = self._input_path_fuzzy()
                    curses.echo()
                    curses.curs_set(1)
                    if path:
                        self.scr.addstr(h-4, 0, " Value ('g'=generate, 'e'=editor): " + " " * (w-36))
                        self.scr.refresh()
                        val = self.scr.getstr(h-4, 35, w-36).decode().strip()
                        if val == "e":
                            curses.noecho()
                            curses.curs_set(0)
                            curses.endwin()
                            editor = os.environ.get("EDITOR", "vim")
                            import tempfile
                            fd, tmppath = tempfile.mkstemp(suffix=".txt", prefix="nsync_")
                            os.close(fd)
                            os.chmod(tmppath, 0o600)
                            try:
                                subprocess.call(f'{editor} "{tmppath}"', shell=True)
                                with open(tmppath) as f:
                                    val = f.read().rstrip("\n")
                            finally:
                                os.unlink(tmppath)
                            self.scr = curses.initscr()
                            curses.noecho()
                            curses.curs_set(0)
                            self.scr.keypad(True)
                            curses.start_color()
                            curses.use_default_colors()
                            curses.init_pair(1, curses.COLOR_GREEN, -1)
                            curses.init_pair(2, curses.COLOR_YELLOW, -1)
                            curses.init_pair(3, curses.COLOR_RED, -1)
                            curses.init_pair(4, curses.COLOR_CYAN, -1)
                            curses.init_pair(5, curses.COLOR_MAGENTA, -1)
                            if val.strip():
                                ok, msg, pending = add_entry(path, val)
                                self.msg = ("Submitted for approval" if pending else "Added!") if ok else f"Error: {msg}"
                                self.load()
                            else:
                                self.msg = "Empty — cancelled"
                        elif val == "g":
                            self.scr.addstr(h-3, 0, " Requirements (Enter=defaults): " + " " * (w-33))
                            self.scr.refresh()
                            reqs = self.scr.getstr(h-3, 32, w-33).decode().strip()
                            curses.noecho()
                            curses.curs_set(0)
                            if not reqs:
                                reqs = "at least 16 characters, one uppercase, one lowercase, one digit, one symbol"
                            self.msg = "Generating..."
                            self.draw()
                            try:
                                p = subprocess.run(
                                    [sys.executable, os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "nsync-genpass"), reqs],
                                    capture_output=True, text=True, timeout=30)
                                val = p.stdout.strip()
                            except Exception as e:
                                val = ""
                                self.msg = f"Generation failed: {e}"
                            if val:
                                self.scr.clear()
                                self.scr.addstr(1, 0, f" Path: {path}", curses.A_BOLD)
                                self.scr.addstr(2, 0, f" Generated: {val}", curses.color_pair(1))
                                self.scr.addstr(4, 0, " Save? [Y/n/r]etry", curses.A_BOLD)
                                self.scr.refresh()
                                ch = self.scr.getch()
                                while ch == ord("r"):
                                    self.scr.addstr(2, 0, " Generating..." + " " * (w-15), curses.color_pair(2))
                                    self.scr.refresh()
                                    try:
                                        p = subprocess.run(
                                            [sys.executable, os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "nsync-genpass"), reqs],
                                            capture_output=True, text=True, timeout=30)
                                        val = p.stdout.strip()
                                    except:
                                        val = ""
                                    if val:
                                        self.scr.addstr(2, 0, f" Generated: {val}" + " " * (w - len(val) - 13), curses.color_pair(1))
                                        self.scr.addstr(4, 0, " Save? [Y/n/r]etry", curses.A_BOLD)
                                        self.scr.refresh()
                                    ch = self.scr.getch()
                                if ch != ord("n") and val:
                                    ok, msg, pending = add_entry(path, val)
                                    if ok:
                                        self.copy_to_clipboard(val)
                                        self.msg = "Submitted — copied!" if pending else "Saved & copied!"
                                    else:
                                        self.msg = f"Error: {msg}"
                                    self.load()
                                else:
                                    self.msg = "Cancelled"
                        elif val:
                            self.scr.addstr(h-3, 0, " Confirm: " + " " * (w-11))
                            self.scr.refresh()
                            confirm = self.scr.getstr(h-3, 10, w-11).decode().strip()
                            curses.noecho()
                            curses.curs_set(0)
                            if confirm != val:
                                self.msg = "Values don't match — cancelled"
                            else:
                                ok, msg, pending = add_entry(path, val)
                                if ok:
                                    self.msg = "Submitted for approval" if pending else "Added!"
                                else:
                                    self.msg = f"Error: {msg}"
                                self.load()
                        else:
                            curses.noecho()
                            curses.curs_set(0)
                            self.msg = "Cancelled"
                    else:
                        curses.noecho()
                        curses.curs_set(0)
                elif key == ord("G"):
                    curses.echo()
                    curses.curs_set(1)
                    h, w = self.scr.getmaxyx()
                    self.scr.clear()
                    self.scr.addstr(0, 0, " Generate Password", curses.A_BOLD)
                    self.scr.addstr(1, 0, " Path: " + " " * (w-8))
                    self.scr.refresh()
                    path = self.scr.getstr(1, 7, w-8).decode().strip()
                    if path:
                        self.scr.addstr(2, 0, " Requirements (or Enter for defaults):")
                        self.scr.addstr(3, 0, " > " + " " * (w-4))
                        self.scr.refresh()
                        reqs = self.scr.getstr(3, 3, w-4).decode().strip()
                        curses.noecho()
                        curses.curs_set(0)
                        if not reqs:
                            reqs = "at least 16 characters, one uppercase, one lowercase, one digit, one symbol"
                        self.scr.addstr(5, 0, " Generating...", curses.color_pair(2))
                        self.scr.refresh()
                        try:
                            p = subprocess.run(
                                [sys.executable, os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "nsync-genpass"), reqs],
                                capture_output=True, text=True, timeout=30)
                            val = p.stdout.strip()
                        except Exception as e:
                            val = ""
                            self.msg = f"Generation failed: {e}"
                        if val:
                            self.scr.addstr(5, 0, f" Generated: {val}" + " " * (w - len(val) - 13), curses.color_pair(1))
                            self.scr.addstr(7, 0, " Save? [Y/n/r]etry ", curses.A_BOLD)
                            self.scr.refresh()
                            ch = self.scr.getch()
                            if ch == ord("r"):
                                # Retry generation
                                self.scr.addstr(5, 0, " Generating..." + " " * (w-15), curses.color_pair(2))
                                self.scr.refresh()
                                try:
                                    p = subprocess.run(
                                        [sys.executable, os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "nsync-genpass"), reqs],
                                        capture_output=True, text=True, timeout=30)
                                    val = p.stdout.strip()
                                except:
                                    val = ""
                                if val:
                                    self.scr.addstr(5, 0, f" Generated: {val}" + " " * (w - len(val) - 13), curses.color_pair(1))
                                    self.scr.addstr(7, 0, " Save? [Y/n]       ", curses.A_BOLD)
                                    self.scr.refresh()
                                    ch = self.scr.getch()
                            if ch != ord("n"):
                                ok, msg, pending = add_entry(path, val)
                                if ok:
                                    self.copy_to_clipboard(val)
                                    self.msg = ("Submitted for approval — copied!" if pending
                                               else "Saved & copied to clipboard!")
                                else:
                                    self.msg = f"Error: {msg}"
                                self.load()
                            else:
                                self.msg = "Cancelled"
                    else:
                        curses.noecho()
                        curses.curs_set(0)
                        self.msg = "Cancelled"
                elif key == ord("D"):
                    if self.filtered:
                        self.msg = f"Delete '{self.filtered[self.sel]}'? [y/N]"
                        self.draw()
                        if self.scr.getch() == ord("y"):
                            nsync(["rm", self.filtered[self.sel]])
                            self.msg = "Deleted"
                            self.load()
                        else:
                            self.msg = ""
                elif key == ord("P"):
                    self.msg = "Pulling..."
                    self.draw()
                    out, _, _ = nsync(["pull"])
                    self.msg = out.strip()[:60]
                    self.load()
                elif 32 <= key <= 126:  # Printable char - live search
                    self.search += chr(key)
                    self.sel = 0
                    self.do_filter()


if __name__ == "__main__":
    curses.wrapper(lambda s: TUI(s).run())
